---
import BaseLayout from '../layouts/BaseLayout.astro';
import Text from '../components/Text.astro';
import PublicationList from '../components/PublicationList.astro';
import NewsList from '../components/NewsList.astro';
import Contact from '../components/Contact.astro';
import { profile, t, has, bioParagraphs } from '../lib/data';
import { localePath, withBase, type Lang } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
---
<BaseLayout lang={lang} path="/">
  <section class="hero">
    {profile.headshot && <img src={withBase(profile.headshot)} alt={ui.headshotAlt} width="144" height="144" />}
    <div class="hero-body">
      <h1>{profile.name[lang]}{lang === 'zh' && <span class="muted"> {profile.romanization}</span>}</h1>
      {(profile.role.en || profile.role.zh) && <p class="role"><Text value={profile.role} lang={lang} /></p>}
      {(profile.affiliation.en || profile.affiliation.zh) && <p class="affil"><Text value={profile.affiliation} lang={lang} /></p>}
      {has.interests() && (
        <ul class="chips">
          {profile.interests.map((i) => <li><Text value={i} lang={lang} /></li>)}
        </ul>
      )}
      <Contact lang={lang} cv />
    </div>
  </section>

  {has.bio() && (
    <Fragment>
      <h2>{ui.about}</h2>
      {bioParagraphs().map((p) => <p><Text value={p} lang={lang} /></p>)}
    </Fragment>
  )}

  {has.interests() && (
    <Fragment>
      <h2>{ui.interests}</h2>
      <ul class="interest-list">
        {profile.interests.map((i) => <li><Text value={i} lang={lang} /></li>)}
      </ul>
    </Fragment>
  )}

  {has.selectedPublications() && (
    <Fragment>
      <h2>{ui.selectedPubs}</h2>
      <PublicationList lang={lang} selectedOnly />
      <p class="more"><a href={localePath(lang, '/publications/')}>{ui.allPubs} →</a></p>
    </Fragment>
  )}

  {has.news() && (
    <Fragment>
      <h2>{ui.latestNews}</h2>
      <NewsList lang={lang} limit={5} />
      <p class="more"><a href={localePath(lang, '/news/')}>{ui.allNews} →</a></p>
    </Fragment>
  )}

  {(profile.email || profile.github || profile.linkedin || profile.scholar) && (
    <Fragment>
      <h2>{ui.contact}</h2>
      <Contact lang={lang} />
    </Fragment>
  )}
</BaseLayout>
