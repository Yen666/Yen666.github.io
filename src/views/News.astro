---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsList from '../components/NewsList.astro';
import { t } from '../lib/data';
import { localePath, type Lang } from '../lib/url';
const { lang } = Astro.props as { lang: Lang };
const ui = t(lang);
---
<BaseLayout lang={lang} path="/news/" title={ui.news}>
  <h1>{ui.news}</h1>
  <p class="more"><a href={localePath(lang, '/rss.xml')}>{ui.rss}</a></p>
  <NewsList lang={lang} />
</BaseLayout>
