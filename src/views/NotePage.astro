---
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { noteTwin, type Note } from '../lib/notes';
import { t } from '../lib/data';
import { altLang, localePath, type Lang } from '../lib/url';
const { lang, note } = Astro.props as { lang: Lang; note: Note };
const ui = t(lang);
const { Content } = await render(note);
const twin = await noteTwin(note, altLang(lang));
const path = `/notes/${note.data.slug}/`;
---
<BaseLayout lang={lang} path={path} altPath={twin ? path : '/notes/'} title={note.data.title} description={note.data.summary} ogType="article">
  <article class="prose">
    <h1>{note.data.title}{note.data.sample && <span class="tag">{ui.sample}</span>}</h1>
    <p class="muted">{note.data.date.toISOString().slice(0, 10)}</p>
    <Content />
  </article>
  <p class="more"><a href={localePath(lang, '/notes/')}>← {ui.notes}</a></p>
</BaseLayout>
